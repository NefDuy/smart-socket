// Copy this file to "secrets.h" (same folder) and fill in your own values.
// secrets.h is listed in .gitignore and must never be committed.
#pragma once

// Firebase Realtime Database host, e.g. "your-project-default-rtdb.firebaseio.com" (no https://)
#define SECRET_FB_HOST      "your-project-default-rtdb.firebaseio.com"
// Database secret / auth token used in the REST calls
#define SECRET_FB_SECRET    "YOUR_FIREBASE_DATABASE_SECRET"
// Password of the setup access point the socket creates on first boot (min. 8 chars)
#define SECRET_AP_PASSWORD  "choose-a-password"
